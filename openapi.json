{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The process is up.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiEnvelopeDto"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/HealthDto"
                        },
                        "success": {
                          "type": "boolean",
                          "enum": [
                            true
                          ]
                        },
                        "errorCode": {
                          "type": "string",
                          "nullable": true,
                          "enum": [
                            null
                          ]
                        }
                      },
                      "required": [
                        "data"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        "summary": "Liveness probe. Reads nothing, needs no database.",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "fpl-backend",
    "description": "The only HTTP surface of the fantasy-premier-league stack. Every response is wrapped in the ApiResponse envelope by a global interceptor; `data` holds the payload and `errorCode` is the stable key to switch on. No authentication anywhere — the product reads the public FPL API only (decision D-013).",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:5001",
      "description": "local"
    }
  ],
  "components": {
    "schemas": {
      "ApiResponseMetaDto": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "description": "Echoed from x-request-id, or generated per request."
          },
          "durationMs": {
            "type": "number",
            "description": "Server-side handling time in milliseconds."
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "dataAsOfGw": {
            "type": "number",
            "description": "Which gameweek's data produced this. Present on every response carrying model output."
          }
        },
        "required": [
          "requestId",
          "durationMs",
          "generatedAt"
        ]
      },
      "ApiEnvelopeDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "statusCode": {
            "type": "number"
          },
          "message": {
            "type": "string"
          },
          "errorCode": {
            "type": "string",
            "nullable": true,
            "description": "Stable machine-readable key on failure, e.g. MANAGER_NOT_FOUND. Null when success is true."
          },
          "meta": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/ApiResponseMetaDto"
              }
            ]
          }
        },
        "required": [
          "success",
          "statusCode",
          "message",
          "errorCode",
          "meta"
        ]
      },
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "service": {
            "type": "string",
            "example": "fpl-backend"
          },
          "uptimeSeconds": {
            "type": "number",
            "description": "Whole seconds since this process started."
          }
        },
        "required": [
          "status",
          "service",
          "uptimeSeconds"
        ]
      }
    }
  }
}
