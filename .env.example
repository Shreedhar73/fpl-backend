# Copy to .env. Anything added here must be added to .env.example in the same commit —
# an undocumented env var is invisible to the next session and the next machine.

PORT=5001
CORS_ORIGIN=http://localhost:5000

DATABASE_URL="postgresql://fpl:fpl@localhost:5432/fpl?schema=public"

# Upstream FPL API. Reads need no auth; writes are deliberately not implemented.
FPL_API_BASE=https://fantasy.premierleague.com/api
FPL_USER_AGENT="fpl-manager/0.1 (personal, non-commercial)"

# Your FPL manager id — the number in the URL of your own team page.
FPL_MANAGER_ID=

# Set false to stop the scheduled sync (useful while developing against a frozen dataset).
SYNC_ENABLED=true
