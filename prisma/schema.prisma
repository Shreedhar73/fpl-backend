// Data model for the FPL manager. The reasoning behind every choice here lives in the
// `fpl-data-model` skill — read it before changing anything in this file.
//
// The organising idea: SNAPSHOT tables mirror upstream's current state and are upserted every
// sync; HISTORY tables are append-only and are the only record of things upstream does not keep
// (price moves, ownership over time, our own projections and solves).
//
// Money is ALWAYS an integer in tenths of a million. 55 == £5.5m. Never a float.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts, not here. The client is constructed
// with a driver adapter (see src/infra/prisma/prisma.service.ts).
datasource db {
  provider = "postgresql"
}

enum Position {
  GKP
  DEF
  MID
  FWD
}

/// SNAPSHOT. `fplId` is 1-20 and alphabetical, so it shifts on promotion/relegation —
/// `code` is the stable cross-season identifier. Join on fplId, persist code.
model Team {
  id                  String   @id @default(cuid())
  fplId               Int      @unique
  code                Int      @unique
  name                String
  shortName           String
  strength            Int
  /// FPL's own team-strength ratings, home/away split. Often 0 early season (uncalibrated) — the
  /// team-strength model treats a 0 as "no signal" and leans on rolling xG + FDR instead.
  strengthOverallHome Int      @default(0)
  strengthOverallAway Int      @default(0)
  strengthAttackHome  Int      @default(0)
  strengthAttackAway  Int      @default(0)
  strengthDefenceHome Int      @default(0)
  strengthDefenceAway Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  players      Player[]
  homeFixtures Fixture[] @relation("HomeTeam")
  awayFixtures Fixture[] @relation("AwayTeam")

  @@map("teams")
}

/// SNAPSHOT of the current player state. Anything here whose past matters also has a history table.
model Player {
  id                       String    @id @default(cuid())
  fplId                    Int       @unique
  code                     Int       @unique
  firstName                String
  secondName               String
  webName                  String
  position                 Position
  teamId                   String
  /// tenths of a million
  nowCost                  Int
  /// a=available d=doubtful i=injured s=suspended u=unavailable n=not in squad. Only 'a' is safe to start.
  status                   String
  /// null means FULLY FIT, not unknown. Treating null as 0 benches every healthy player.
  chanceOfPlayingNextRound Int?
  news                     String?
  newsAddedAt              DateTime?
  removed                  Boolean   @default(false)

  // --- Projection inputs, from the bootstrap element (season-to-date). Snapshot: upserted each sync.
  //     `ep*`/`form` are decimal STRINGS upstream, parsed at the boundary. Nullable = absent preseason.
  form                       Decimal? @db.Decimal(6, 2)
  pointsPerGame              Decimal? @db.Decimal(6, 2)
  /// FPL's own expected points for the next / current gameweek — the baseline the model must beat.
  epNext                     Decimal? @db.Decimal(6, 2)
  epThis                     Decimal? @db.Decimal(6, 2)
  expectedGoalsPer90         Decimal  @default(0) @db.Decimal(6, 2)
  expectedAssistsPer90       Decimal  @default(0) @db.Decimal(6, 2)
  expectedGoalsConcededPer90 Decimal  @default(0) @db.Decimal(6, 2)
  defensiveContributionPer90 Decimal  @default(0) @db.Decimal(6, 2)
  savesPer90                 Decimal  @default(0) @db.Decimal(6, 2)
  startsPer90                Decimal  @default(0) @db.Decimal(5, 3)
  /// set-piece duty — null means not a taker. A large, cheap rate signal.
  penaltiesOrder             Int?
  directFreekicksOrder       Int?
  cornersOrder               Int?
  seasonMinutes              Int      @default(0)
  seasonStarts               Int      @default(0)

  updatedAt DateTime @updatedAt

  team              Team                     @relation(fields: [teamId], references: [id])
  gameweekStats     PlayerGameweekStat[]
  priceHistory      PlayerPriceHistory[]
  ownershipHistory  PlayerOwnershipHistory[]
  seasonHistory     PlayerSeasonHistory[]
  projections       Projection[]
  squadPicks        SquadPick[]
  archiveGameweeks  ArchivePlayerGameweek[]
  deadlineSnapshots PlayerDeadlineSnapshot[]

  @@index([teamId])
  @@index([position])
  @@index([status])
  @@map("players")
}

/// HISTORY (per prior season, from element-summary `history_past`). One row per (player, season) of
/// SEASON TOTALS — the public API exposes no per-gameweek detail for finished seasons. The model uses
/// the last two as an early-season prior, and last season's points as a baseline.
model PlayerSeasonHistory {
  id                    String   @id @default(cuid())
  playerId              String
  /// e.g. "2024/25"
  season                String
  totalPoints           Int
  minutes               Int
  starts                Int      @default(0)
  goalsScored           Int      @default(0)
  assists               Int      @default(0)
  cleanSheets           Int      @default(0)
  goalsConceded         Int      @default(0)
  saves                 Int      @default(0)
  bonus                 Int      @default(0)
  bps                   Int      @default(0)
  defensiveContribution Int      @default(0)
  expectedGoals         Decimal  @default(0) @db.Decimal(7, 2)
  expectedAssists       Decimal  @default(0) @db.Decimal(7, 2)
  expectedGoalsConceded Decimal  @default(0) @db.Decimal(7, 2)
  /// tenths of a million
  startCost             Int
  endCost               Int
  updatedAt             DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, season])
  @@index([playerId])
  @@map("player_season_history")
}

/// SNAPSHOT. `deadlineTime` is UTC. `finished` is NOT final — bonus and stat corrections land
/// afterwards, and only `dataChecked` means the numbers stopped moving. Backtests filter on it.
model Gameweek {
  id           Int      @id
  name         String
  deadlineTime DateTime @db.Timestamptz(3)
  finished     Boolean  @default(false)
  dataChecked  Boolean  @default(false)
  isCurrent    Boolean  @default(false)
  isNext       Boolean  @default(false)
  averageScore Int?
  highestScore Int?
  updatedAt    DateTime @updatedAt

  fixtures          Fixture[]
  playerStats       PlayerGameweekStat[]
  projections       Projection[]
  squads            Squad[]
  deadlineSnapshots PlayerDeadlineSnapshot[]
  liveSnapshot      GameweekLiveSnapshot?

  @@map("gameweeks")
}

/// SNAPSHOT. `event` and `kickoffTime` are nullable — an unscheduled or unassigned fixture is
/// normal upstream, and both break a naive sort.
model Fixture {
  id             String    @id @default(cuid())
  fplId          Int       @unique
  gameweekId     Int?
  kickoffTime    DateTime? @db.Timestamptz(3)
  homeTeamId     String
  awayTeamId     String
  homeScore      Int?
  awayScore      Int?
  homeDifficulty Int
  awayDifficulty Int
  started        Boolean   @default(false)
  finished       Boolean   @default(false)
  updatedAt      DateTime  @updatedAt

  gameweek Gameweek?            @relation(fields: [gameweekId], references: [id])
  homeTeam Team                 @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam Team                 @relation("AwayTeam", fields: [awayTeamId], references: [id])
  stats    PlayerGameweekStat[]

  @@index([gameweekId])
  @@index([homeTeamId, gameweekId])
  @@index([awayTeamId, gameweekId])
  @@map("fixtures")
}

/// HISTORY, and the fact table everything models on. Fixture is part of the key because
/// double gameweeks are real: one player, one gameweek, two fixtures, two rows.
model PlayerGameweekStat {
  id                String  @id @default(cuid())
  playerId          String
  gameweekId        Int
  fixtureId         String
  wasHome           Boolean
  opponentTeamFplId Int

  minutes               Int @default(0)
  starts                Int @default(0)
  totalPoints           Int @default(0)
  goalsScored           Int @default(0)
  assists               Int @default(0)
  cleanSheets           Int @default(0)
  goalsConceded         Int @default(0)
  ownGoals              Int @default(0)
  penaltiesSaved        Int @default(0)
  penaltiesMissed       Int @default(0)
  yellowCards           Int @default(0)
  redCards              Int @default(0)
  saves                 Int @default(0)
  bonus                 Int @default(0)
  bps                   Int @default(0)
  /// the 2025/26 scoring category: DEF/MID/FWD earn +2 at the threshold
  defensiveContribution Int @default(0)

  /// upstream sends these as decimal STRINGS; parsed at the sync boundary, stored as Decimal
  expectedGoals         Decimal @default(0) @db.Decimal(6, 2)
  expectedAssists       Decimal @default(0) @db.Decimal(6, 2)
  expectedGoalsConceded Decimal @default(0) @db.Decimal(6, 2)
  ictIndex              Decimal @default(0) @db.Decimal(6, 1)

  /// tenths of a million, the player's price at that gameweek
  value      Int
  selectedBy Int      @default(0)
  createdAt  DateTime @default(now())

  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  gameweek Gameweek @relation(fields: [gameweekId], references: [id])
  fixture  Fixture  @relation(fields: [fixtureId], references: [id])

  @@unique([playerId, gameweekId, fixtureId])
  @@index([playerId, gameweekId])
  @@index([gameweekId])
  @@map("player_gameweek_stats")
}

/// HISTORY. Upstream serves NO price history — `now_cost` is a scalar snapshot. This table is
/// the only place the series exists, which is why a database reset loses it permanently.
model PlayerPriceHistory {
  id         String   @id @default(cuid())
  playerId   String
  /// tenths of a million
  cost       Int
  recordedAt DateTime @db.Timestamptz(3)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, recordedAt])
  @@index([playerId, recordedAt(sort: Desc)])
  @@map("player_price_history")
}

/// HISTORY. Same reason: upstream serves ownership for the current event only.
model PlayerOwnershipHistory {
  id                String   @id @default(cuid())
  playerId          String
  selectedByPercent Decimal  @db.Decimal(5, 2)
  transfersInEvent  Int      @default(0)
  transfersOutEvent Int      @default(0)
  recordedAt        DateTime @db.Timestamptz(3)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, recordedAt])
  @@index([playerId, recordedAt(sort: Desc)])
  @@map("player_ownership_history")
}

/// HISTORY, append-only. NEVER overwrite a projection: the backtest is the whole point of
/// keeping them, and it needs what the model said at the time, not what it would say now.
model Projection {
  id           String @id @default(cuid())
  playerId     String
  gameweekId   Int
  modelVersion String

  expectedPoints  Decimal  @db.Decimal(6, 2)
  expectedMinutes Decimal  @db.Decimal(6, 2)
  /// P(the player features at all) — the term that dominates every other one
  playProbability Decimal  @db.Decimal(4, 3)
  /// per-term breakdown + the inputs, so the UI can show WHY and the run can be reconstructed
  components      Json
  createdAt       DateTime @default(now())

  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  gameweek Gameweek @relation(fields: [gameweekId], references: [id])

  @@unique([playerId, gameweekId, modelVersion])
  @@index([gameweekId, modelVersion, expectedPoints(sort: Desc)])
  @@map("projections")
}

/// HISTORY. The user's squad per gameweek, including planned future squads.
model Squad {
  id         String   @id @default(cuid())
  managerId  Int
  gameweekId Int
  /// tenths of a million
  bank       Int
  teamValue  Int
  activeChip String?
  isPlanned  Boolean  @default(false)
  createdAt  DateTime @default(now())

  gameweek Gameweek    @relation(fields: [gameweekId], references: [id])
  picks    SquadPick[]

  @@unique([managerId, gameweekId, isPlanned])
  @@map("squads")
}

model SquadPick {
  id            String  @id @default(cuid())
  squadId       String
  playerId      String
  /// 1-11 starting XI, 12-15 bench in substitution order — bench order is a real decision
  position      Int
  multiplier    Int     @default(1)
  isCaptain     Boolean @default(false)
  isViceCaptain Boolean @default(false)
  /// What we would get back on a sale: purchase price + half the rise, rounded down.
  ///
  /// NULLABLE, and null is the normal state for an imported squad. No public endpoint carries a
  /// purchase or selling price — `entry/{id}/event/{gw}/picks/` has neither (verified against the
  /// live API 2026-08-26), and both live in `my-team/{id}/`, which is 403 without authentication.
  /// We never authenticate (D-013).
  ///
  /// Do NOT fill this with `nowCost` to avoid the null. Only the transfer planner (B-008) reads it,
  /// and its entire job is that sell value differs from market price — an approximation here is a
  /// wrong number consumed there with no tell, where a null is loud. B-008 reconstructs it by
  /// replaying `entry/{id}/transfers/` against `player_price_history`.
  sellValue     Int?

  squad  Squad  @relation(fields: [squadId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id])

  @@unique([squadId, position])
  @@index([playerId])
  @@map("squad_picks")
}

/// HISTORY. One row per solve. A recommendation you cannot reconstruct is one you cannot debug,
/// and the UI's "why" panel reads straight out of here.
model OptimizerRun {
  id             String   @id @default(cuid())
  gameweekId     Int
  modelVersion   String
  horizon        Int
  freeTransfers  Int
  hitsTaken      Int
  objectiveValue Decimal  @db.Decimal(8, 2)
  inputs         Json
  result         Json
  reasoning      Json
  durationMs     Int
  createdAt      DateTime @default(now())

  @@index([gameweekId, createdAt(sort: Desc)])
  @@map("optimizer_runs")
}

/// HISTORY. The first place to look when the data looks wrong: what ran, what it wrote, and
/// whether the upstream payload had actually changed.
model SyncRun {
  id          String    @id @default(cuid())
  endpoint    String
  mode        String
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  rowsWritten Int       @default(0)
  status      String    @default("running")
  payloadHash String?
  error       String?

  @@index([endpoint, startedAt(sort: Desc)])
  @@map("sync_runs")
}

/// SNAPSHOT of upstream's own `game_config.scoring` / `.rules`. The points engine reads THESE,
/// never constants — FPL changed goalkeeper goal scoring and added a whole scoring category
/// within two seasons, and a hardcoded table is silently wrong the day it changes.
model ScoringConfig {
  id        String   @id @default(cuid())
  season    String   @unique
  scoring   Json
  rules     Json
  /// Per-position squad quotas from `element_types` (squad_select / squad_min_play / squad_max_play),
  /// so the optimizer reads formation constraints from config rather than hardcoding 2/5/5/3.
  positions Json?
  updatedAt DateTime @updatedAt

  @@map("scoring_config")
}

/// THIRD-PARTY ARCHIVE — per-gameweek rows scraped from the FPL API by
/// github.com/vaastav/Fantasy-Premier-League, which is where they exist and the official API does not:
/// `element-summary/{id}/history_past` returns season TOTALS only. Held for the last three completed
/// seasons (2023-24, 2024-25, 2025-26) so the projection model can be fitted on ~87k player-gameweeks
/// instead of the one gameweek this season has produced (B-007 Phase 2b).
///
/// Kept in its OWN table on purpose. These rows are a scrape under an unclear licence, not our sync,
/// and nothing in the serving path may read them — a row that cannot be traced to the source that
/// produced it is a row nobody can audit later. They join to ours only through the stable `code`.
///
/// NOT stored: the archive's `xP` column. It is FPL's `ep_this` scraped AFTER each gameweek ended, so
/// it carries post-match information (the archive's own README documents this and advises dropping
/// it). Absent from the schema so a later session cannot reach for it without reading why.
model ArchivePlayerGameweek {
  id      String @id @default(cuid())
  /// as the archive labels it: "2025-26"
  season  String
  /// gameweek within that season (the archive's `round`)
  round   Int
  /// that season's fixture id — part of the key, so a double gameweek is two rows
  fixture Int

  /// STABLE across seasons, unlike the per-season `element` id. The join key to `Player.code`.
  playerCode       Int
  /// null when the player has since left the league and has no row of ours. The fit needs them.
  playerId         String?
  webName          String
  position         Position
  teamCode         Int?
  opponentTeamCode Int?
  wasHome          Boolean
  kickoffTime      DateTime?

  minutes         Int @default(0)
  starts          Int @default(0)
  totalPoints     Int @default(0)
  goalsScored     Int @default(0)
  assists         Int @default(0)
  cleanSheets     Int @default(0)
  goalsConceded   Int @default(0)
  ownGoals        Int @default(0)
  penaltiesSaved  Int @default(0)
  penaltiesMissed Int @default(0)
  yellowCards     Int @default(0)
  redCards        Int @default(0)
  saves           Int @default(0)
  bonus           Int @default(0)
  bps             Int @default(0)

  /// 2025-26 onward only — the category did not exist before, so NULL means "not a thing yet",
  /// which is not the same as 0. The components are stored beside the total because a threshold
  /// model fits the components and predicts the total.
  defensiveContribution         Int?
  clearancesBlocksInterceptions Int?
  tackles                       Int?
  recoveries                    Int?

  expectedGoals         Decimal @default(0) @db.Decimal(6, 2)
  expectedAssists       Decimal @default(0) @db.Decimal(6, 2)
  expectedGoalsConceded Decimal @default(0) @db.Decimal(6, 2)
  ictIndex              Decimal @default(0) @db.Decimal(6, 1)

  /// tenths of a million, the player's price that gameweek
  value      Int      @default(0)
  selectedBy Int      @default(0)
  createdAt  DateTime @default(now())

  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([season, playerCode, round, fixture])
  @@index([season, round])
  @@index([playerCode])
  @@map("archive_player_gameweek")
}

/// The scoring table for a PAST season, reconstructed by hand — upstream serves only the current
/// season's `game_config`, and the archive carries none. Separate from `scoring_config` because that
/// one is a synced mirror and this one is our reconstruction; mixing them would make a hand-entered
/// row indistinguishable from an upstream one.
///
/// Each row is proved rather than trusted: `pointsFor` must reproduce that season's official
/// `total_points` for every archive row, exactly as it does for the live gameweek.
model ArchiveSeasonScoring {
  id        String   @id @default(cuid())
  season    String   @unique
  scoring   Json
  /// what the values were checked against, so a future session can re-check them
  source    String
  updatedAt DateTime @updatedAt

  @@map("archive_season_scoring")
}

/// DEADLINE SNAPSHOT — the only record of what was knowable BEFORE a gameweek.
///
/// `players` is a snapshot table: `status`, `chanceOfPlayingNextRound`, `epNext`, `epThis`, `form`,
/// `nowCost` and the set-piece orders are overwritten on every sync, kept nowhere, and served by no
/// public archive. After a deadline they say what was true AFTER the matches, so a minutes model
/// backtested against them is reading the answer, and `ep_next` — the baseline the model is measured
/// against — cannot be scored for any gameweek that has already gone.
///
/// This table is also the ONLY route to ever fitting the availability half of the minutes model: the
/// community archive carries no per-gameweek `status` or `chance_of_playing` either (D-016), so
/// nothing that has not been captured here can be recovered later from anywhere.
///
/// One row per player per gameweek, upserted, so the last capture before a deadline is the one kept.
model PlayerDeadlineSnapshot {
  id         String @id @default(cuid())
  playerId   String
  gameweekId Int

  /// a=available d=doubtful i=injured s=suspended u=unavailable n=not in squad
  status                   String
  /// null means FULLY FIT, not unknown. Treating null as 0 benches every healthy player.
  chanceOfPlayingNextRound Int?
  news                     String?
  newsAddedAt              DateTime?

  /// FPL's own expected points — the baseline the model has to beat, and unrecoverable once overwritten
  epNext Decimal? @db.Decimal(6, 2)
  epThis Decimal? @db.Decimal(6, 2)
  form   Decimal? @db.Decimal(6, 2)

  /// tenths of a million, the price the optimiser would actually have paid at this deadline
  nowCost Int

  /// set-piece duty — a large, cheap rate signal that flips without notice and is a scalar upstream
  penaltiesOrder       Int?
  directFreekicksOrder Int?
  cornersOrder         Int?

  /// when this was taken, NOT the deadline — several captures per gameweek are expected and the
  /// latest one before the deadline is the one that describes the decision
  capturedAt      DateTime @default(now())
  /// hours between the capture and the deadline; a capture taken 20 hours out is weaker evidence
  /// about a late fitness call than one taken at two, and the fit has to be able to tell them apart
  hoursToDeadline Decimal  @db.Decimal(6, 2)

  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  gameweek Gameweek @relation(fields: [gameweekId], references: [id])

  @@unique([playerId, gameweekId])
  @@index([gameweekId])
  @@map("player_deadline_snapshot")
}

/// RAW CAPTURE. `event/{gw}/live/` in full, one row per gameweek.
///
/// The `explain` blocks inside it are FPL's own per-identifier answer key — what each player was paid
/// for, term by term — and they are the only thing that ever let this project verify its points
/// engine against the source rather than against its own reading of the rules (B-007 Phase 1).
///
/// **They are gone at season rollover.** The endpoint serves the CURRENT season only, and no archive
/// carries them. So the choice was 38 committed JSON fixtures at ~440 KB each — about 17 MB of
/// repository — or a table. The table won: it is captured by the ordinary sync rather than by
/// somebody remembering, it does not bloat every clone, and a raw payload in a repo is a fixture
/// nobody updates.
///
/// Stored whole and unparsed on purpose. The value of a raw capture is that it still answers a
/// question nobody has asked yet, and a parsed subset only answers the ones we thought of.
model GameweekLiveSnapshot {
  gameweekId Int      @id
  /// the full `event/{gw}/live/` payload, exactly as served
  payload    Json
  /// how many elements the payload carried, so an empty capture is visible without parsing the blob
  elements   Int
  capturedAt DateTime @default(now())

  gameweek Gameweek @relation(fields: [gameweekId], references: [id])

  @@map("gameweek_live_snapshot")
}
